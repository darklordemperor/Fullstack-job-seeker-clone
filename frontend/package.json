{
  "name": "job-sdb-clone",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "check:architecture": "node scripts/check-architecture.mjs",
    "prebuild": "npm run check:architecture",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run check:architecture",
    "test": "ng test",
    "check:e2e": "tsc -p tsconfig.e2e.json",
    "pretest:e2e": "npm run check:e2e",
    "test:e2e": "playwright test",
    "pretest:e2e:chromium": "npm run check:e2e",
    "test:e2e:chromium": "playwright test --project=chromium",
    "pretest:coverage": "npm run check:architecture",
    "test:coverage": "ng test --watch=false --coverage"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@ngrx/operators": "^21.1.0",
    "@ngrx/signals": "^21.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.28",
    "@angular/cli": "^21.2.28",
    "@angular/compiler-cli": "^21.2.25",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "4.1.12",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@angular/build": {
      "undici": "7.30.1"
    }
  }
}
